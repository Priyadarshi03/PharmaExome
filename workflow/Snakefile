rule parse_pgx:
    input:
        vcf="results/pgx/{sample}.pgx.vcf",
        bed="resources/pgx_genes.bed"
    output:
        "results/pgx/{sample}_pgx_variants.tsv"
    shell:
        """
        mkdir -p results/pgx

        python scripts/parse_vcf.py \
        {input.vcf} \
        {input.bed} \
        {output}
        """

rule phenotype:
    input:
        "results/pgx/{sample}_pgx_variants.tsv"
    output:
        "results/pgx/{sample}_phenotypes.tsv"
    shell:
        """
        python scripts/phenotype_assignment.py \
        {input} \
        {output}
        """

rule drug_annotation:
    input:
        "results/pgx/{sample}_phenotypes.tsv"
    output:
        "results/pgx/{sample}_drug_recommendations.tsv"
    shell:
        """
        python scripts/annotate_drugs.py \
        {input} \
        {output}
        """

rule report:
    input:
        phenotypes="results/pgx/{sample}_phenotypes.tsv",
        drugs="results/pgx/{sample}_drug_recommendations.tsv"
    output:
        "results/report/{sample}_report.pdf"
    shell:
        """
        mkdir -p results/report

        python scripts/generate_report.py \
        {input.phenotypes} \
        {input.drugs} \
        {output}
        """