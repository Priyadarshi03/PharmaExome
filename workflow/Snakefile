configfile: "config/config.yaml"

SAMPLE = config["sample"]
REF = config["reference"]

rule all:
    input:
        expand("results/report/{sample}_report.pdf",
        sample=[config["sample"]])

rule fastqc:
    input:
        r1="samples/{sample}_R1_001.fastq.gz",
        r2="samples/{sample}_R2_001.fastq.gz"
    output:
        html1="results/qc/{sample}_R1_fastqc.html",
        html2="results/qc/{sample}_R2_fastqc.html"
    shell:
        """
        mkdir -p results/qc
        fastqc {input.r1} {input.r2} -o /results/qc
        """

rule fastp:
    input:
        r1="samples/{sample}_R1_001.fastq.gz",
        r2="samples/{sample}_R2_001.fastq.gz"
    output:
        r1="results/trimmed/{sample}_R1.trim.fastq.gz",
        r2="results/trimmed/{sample}_R2.trim.fastq.gz"
    shell:
        """
        mkdir -p results/trimmed
        fastp \
          -i {input.r1} \
          -I {input.r2} \
          -o {output.r1} \
          -O {output.r2}
        """

rule bwa:
    input:
        r1="results/trimmed/{sample}_R1.trim.fastq.gz",
        r2="results/trimmed/{sample}_R2.trim.fastq.gz",
        ref=REF
    output:
        bam="results/bam/{sample}.sorted.bam"
    threads:
        config["threads"]
    shell:
        """
        mkdir -p results/bam

        bwa mem -t {threads} {input.ref} \
        {input.r1} {input.r2} | \
        samtools sort -o {output.bam}

        samtools index {output.bam}
        """

rule variant_calling:
    input:
        bam="results/bam/{sample}.sorted.bam",
        ref=REF
    output:
        vcf="results/vcf/{sample}.vcf.gz"
    threads: 12

    shell:
        """
        mkdir -p results/vcf

        bcftools mpileup \
        -Ou \
        -f {input.ref} \
        {input.bam} | \
        bcftools call \
        --threads {threads} \
        -mv \
        -Oz \
        -o {output.vcf}

        tabix -p vcf {output.vcf}
        """

rule pgx_filter:
    input:
        vcf="results/vcf/{sample}.vcf.gz",
        bed="resources/pgx_genes.bed"
    output:
        "results/pgx/{sample}.pgx.vcf"
    shell:
        """
        mkdir -p results/pgx

        bedtools intersect \
            -header \
            -a {input.vcf} \
            -b {input.bed} \
            > {output}
        """

